rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — readable by any authenticated user, writable only by owner
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;

      match /friends/{friendUid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Friend requests — sender or recipient can read/delete; only sender creates
    match /friendRequests/{requestId} {
      allow read: if request.auth != null &&
        (resource.data.fromUid == request.auth.uid ||
         resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.fromUid == request.auth.uid;
      allow delete: if request.auth != null &&
        (resource.data.fromUid == request.auth.uid ||
         resource.data.toUid == request.auth.uid);
    }

    // Sessions — host and participant can read/update; host creates
    match /sessions/{sessionId} {
      allow read: if request.auth != null &&
        (resource.data.hostId == request.auth.uid ||
         resource.data.participantId == request.auth.uid ||
         resource.data.status == 'waiting');
      allow create: if request.auth != null &&
        request.resource.data.hostId == request.auth.uid;
      allow update: if request.auth != null &&
        (resource.data.hostId == request.auth.uid ||
         resource.data.participantId == request.auth.uid);
    }

    // Session invites — sender or recipient can read; only sender creates; recipient updates status
    match /sessionInvites/{inviteId} {
      allow read: if request.auth != null &&
        (resource.data.fromUid == request.auth.uid ||
         resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.toUid == request.auth.uid;
    }

    // Session history — owner only
    match /sessionHistory/{entryId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
