# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project values.
# Get these from: Firebase Console → Project Settings → General → Your apps → Web app

EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Vercel Notification Server
# After deploying server/ to Vercel, paste the deployment URL here
EXPO_PUBLIC_NOTIFY_URL=https://your-server.vercel.app
# Random secret — must match NOTIFY_SECRET in Vercel env vars
# Generate with: openssl rand -hex 32
EXPO_PUBLIC_NOTIFY_SECRET=your-random-secret-here
