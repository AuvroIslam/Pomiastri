# Set these in Vercel Dashboard → Project Settings → Environment Variables

# Firebase Admin SDK — generate from:
# Firebase Console → Project Settings → Service accounts → Generate new private key
# Paste the entire JSON as a single line (use https://www.json-minifier.com)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Simple secret — generate any random string (e.g. openssl rand -hex 32)
# Must match EXPO_PUBLIC_NOTIFY_SECRET in your app's .env.local
NOTIFY_SECRET=your-random-secret-here
